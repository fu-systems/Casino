; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Casino"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.5")
config/icon="res://icon.svg"

[autoload]

Bank="*res://scripts/bank.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; "expand" keeps the 1280x720 design size as a *minimum* in both directions
; and grows the viewport into whatever the device has spare, so no screen
; gets letterboxed and no layout is ever squeezed below its design width.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 4 = Sensor Landscape: locked out of portrait, but usable held either way.
window/handheld/orientation=4

[rendering]

environment/defaults/default_clear_color=Color(0.043, 0.29, 0.133, 1)
; Required by the Android export: without it Godot rejects the preset, and
; the check that does so appends no message, so the export fails with a
; blank "configuration errors" list.
textures/vram_compression/import_etc2_astc=true
